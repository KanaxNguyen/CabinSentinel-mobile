{
  "name": "@cabinsentinel/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android --output-dir dist",
    "eas:preview:android": "npx --yes eas-cli@latest build --profile preview --platform android",
    "eas:preview:ios": "npx --yes eas-cli@latest build --profile preview --platform ios",
    "eas:production:android": "npx --yes eas-cli@latest build --profile production --platform android",
    "eas:production:ios": "npx --yes eas-cli@latest build --profile production --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "expo export --platform web --output-dir dist --clear"
  },
  "dependencies": {
    "@cabinsentinel/api-client": "*",
    "@cabinsentinel/contracts": "*",
    "@cabinsentinel/domain": "*",
    "@expo/metro-runtime": "~6.1.2",
    "expo": "^54.0.0",
    "expo-linking": "~8.0.0",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "~6.0.2",
    "vitest": "^3.0.5"
  }
}
